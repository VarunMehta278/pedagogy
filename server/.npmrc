# The build needs devDependencies: typescript and every @types/* package.
#
# Render (and most PaaS hosts) set NODE_ENV=production on the service.
# npm treats that as `--omit=dev`, so `npm install` silently skips
# typescript and @types/*, and `npm run build` then fails with
# TS7016 "Could not find a declaration file for module 'express'"
# and TS2591 "Cannot find name 'process'".
#
# `include` overrides `omit` regardless of order, so this also
# neutralises the older NPM_CONFIG_PRODUCTION=true convention.
include=dev
