# Copy this file to .env and fill in the real values.
#
#   cp .env.example .env
#
# .env is gitignored and must stay that way.

# Port the API listens on. The client defaults to 5001.
PORT=5001

# Secret used to sign session JWTs. Must be a long random string —
# anyone holding it can mint a valid session for any account.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Your Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# The service role key. This bypasses row level security, so it is
# server-only and must never be exposed to the browser or committed.
SUPABASE_SERVICE_ROLE_KEY=

# Origin(s) allowed by CORS, in addition to http://localhost:3000.
# Several may be listed, separated by commas, so a preview deployment
# can be allowed alongside the production domain. Give the bare origin
# with no path and no trailing slash, e.g.
#   FRONTEND_URL=https://pedagogy.vercel.app
FRONTEND_URL=http://localhost:3000

# Set to "production" on the deployed API only. It switches the session
# cookie to SameSite=None; Secure, which is what lets the browser send
# it to this API from the frontend's own domain. Leave it unset locally,
# where the cookie stays SameSite=Lax over plain http://localhost.
# NODE_ENV=production
