# ---------------------------------------------------------------
# Pedagogy — repository root
#
# This covers both client/ and server/ so that whichever folder a
# command is run from, secrets and build output stay out of git.
# ---------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Secrets — never commit these.
# server/.env holds SUPABASE_SERVICE_ROLE_KEY, which bypasses row
# level security entirely, and JWT_SECRET, which can mint a valid
# session for any account. Committing either one, even to a
# private repo, means rotating both.
.env
.env.*
!.env.example
*.pem
*.key

# Saved login sessions from manual curl testing. These contain a
# real, unexpired JWT.
cookies.txt
*-cookies.txt

# Testing
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
